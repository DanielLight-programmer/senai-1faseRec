programa {
  funcao inicio() {
     // informações e variaveis
      real valor_pago, valor_venda
     //entrada de dados
      escreva("Quanto ele pagou pela obra? ")
       leia(valor_pago)
     //processamento
    valor_venda = valor_pago + (valor_pago*2)
     //saída
     escreva("Qual preço recomendado de venda R$ " + valor_venda)
  }
}
