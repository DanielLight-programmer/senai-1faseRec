programa {
  funcao inicio() {
   //infos e variáveis
   inteiro numero
   //entrada de dados
   escreva("Digite o número do dia da semana: ")
   leia(numero)
   //processamentos
   se(numero == 1 ){
    escreva("Domingo")
   }senao se (numero == 2){
    escreva("Segunda")
   }senao se (numero == 3){
    escreva("Terça")
    }senao se (numero == 4){
 escreva("Quarta")
  }senao se (numero == 5){
    escreva("Quinta")
  }senao se (numero == 6){
    escreva("Sexta")
  }senao se (numero == 7){
      escreva("Sábado")
    }senao{
      escreva("Dia da semana inválido, SEU BURRO!!!😡")
    }
    //saídas 
   }
   
}
