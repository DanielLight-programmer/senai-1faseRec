programa {
  funcao inicio() {
   // informações e variaveis
  inteiro pessoas
  real carne, cerveja, agua, refri
   //ler dados
escreva("Digite a quantidade de pessoas para o churrasco: ")
leia(pessoas)
   //processamento
carne = pessoas*0.5
cerveja = pessoas*1
agua = pessoas*0.5
refri = pessoas*0.2
escreva("carne" + carne + "kg\n")
escreva("kg\n")
escreva("kg\n")
escreva("kg\n")

   //saída


  }
}
